<Application x:Class="SoundVisualizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SoundVisualizer"
             StartupUri="LauncherWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 색(Palette.xaml)과 카드·버튼·스위치·슬라이더 같은 공통 서식. 런처, 오버레이 편집 패널, 색 선택 창이 함께 쓴다. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundVisualizer;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 앱 전체 글꼴. 언어에 맞는 대체 글꼴 순서는 시작할 때와 언어를 바꿀 때 AppFonts.Apply 가 다시 정한다. -->
            <FontFamily x:Key="AppFontFamily">./Fonts/#Pretendard, Segoe UI, Malgun Gothic</FontFamily>

            <!-- 고정폭 글꼴(도움말의 환경 정보, 오픈소스 라이선스 창). 고지는 고정폭 기준으로 줄을 맞춰 적혀 있다. Windows 에 늘 있는 글꼴이다. -->
            <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Courier New</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
