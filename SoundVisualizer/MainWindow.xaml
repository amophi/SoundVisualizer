<Window x:Class="SoundVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SoundVisualizer.Localization"
        xmlns:ui="clr-namespace:SoundVisualizer.Ui"
        Title="Sound Visualizer" Height="1080" Width="1920"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Topmost="True" WindowState="Maximized" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        FontFamily="{DynamicResource AppFontFamily}">
    
    <Window.Resources>
        <!-- 편집 화면의 가이드라인과 그 라벨 색. 패널이 아니라 화면 위에 그리는 그래픽이라 예전 색 그대로 둔다
             (앱 팔레트의 멈춤 빨강 #D32F2F 는 편집 화면 바탕 위에서 2.8:1 로 그림 요소 기준 3:1 에 모자란다).
             패널과 HUD 글자는 Themes/Theme.xaml 의 색과 서식을 쓴다. -->
        <SolidColorBrush x:Key="GuideBlueBrush" Color="#3182F6"/>
        <SolidColorBrush x:Key="GuideRedBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="GuideBorderBrush" Color="#222429"/>
    </Window.Resources>
    
    <Grid x:Name="MainGrid">
        <!-- 시스템 상태 메시지 (상단 고정) -->
        <Border x:Name="StatusBorder" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,50,0,0" 
                Background="#60000000" CornerRadius="5" Padding="10,5" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Text="{l:Loc hud.status.ready}" TextAlignment="Center"/>
        </Border>

        <!-- 통합 파도 (하나의 연속적인 둘레 웨이브) -->
        <Path x:Name="UnifiedWave" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity="0.6">
            <Path.Effect>
                <DropShadowEffect x:Name="WaveGlowEffect" Color="White" BlurRadius="25" ShadowDepth="0" Opacity="0" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- AI 라벨 (화면 정중앙) -->
        <Border x:Name="AILabelBorder" HorizontalAlignment="Center" VerticalAlignment="Center" 
                Background="#90000000" CornerRadius="15" Padding="20" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="AILabelText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="26" 
                       FontWeight="Bold" Text=""/>
        </Border>

        <!-- FPS 카운터 (디버그용, 우상단) -->
        <Border x:Name="FpsBorder" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,50,20,0" 
                Background="#60000000" CornerRadius="5" Padding="8,4" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="FpsText" Foreground="#80FFFFFF" FontSize="11" Text="FPS: --"/>
        </Border>

        <!-- 모드 설정 UI (우하단) -->
        <StackPanel x:Name="ModeUIStack" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,20" IsHitTestVisible="False">
            <Border Background="#80000000" CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
                <TextBlock x:Name="VisualModeText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#80000000" CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
                <TextBlock x:Name="StereoModeText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#80000000" CornerRadius="5" Padding="12,8">
                <TextBlock x:Name="EditModeText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- 실시간 오버레이 편집 모드 패널 (F4) -->
        <Grid x:Name="EditOverlayGrid" Visibility="Collapsed" Background="#F22A2C31">
            <!-- 가이드라인 인터랙션 영역 -->
            <Canvas x:Name="GuidelineCanvas" Background="Transparent" MouseDown="GuidelineCanvas_MouseDown" MouseMove="GuidelineCanvas_MouseMove" MouseUp="GuidelineCanvas_MouseUp">
                <!-- 사각형 가이드라인 (파도 / 패드 / 외곽선 모드) -->
                <Border x:Name="RectGuideline" BorderBrush="{StaticResource GuideRedBrush}" BorderThickness="2" CornerRadius="10" Background="Transparent" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#E53935" BlurRadius="15" ShadowDepth="0"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="Thumb">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <!-- 영역 명칭 및 크기값 제거 (화면 상단으로 이동됨) -->
                        
                        <!-- 크기 조절용 4개 모서리 Thumb (드래그 감지) -->
                        <Thumb x:Name="ResizeHandle_NW" Width="14" Height="14" Background="{StaticResource GuideBlueBrush}" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-7" Cursor="SizeNWSE" DragDelta="ResizeHandle_DragDelta"/>
                        <Thumb x:Name="ResizeHandle_NE" Width="14" Height="14" Background="{StaticResource GuideBlueBrush}" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-7" Cursor="SizeNESW" DragDelta="ResizeHandle_DragDelta"/>
                        <Thumb x:Name="ResizeHandle_SW" Width="14" Height="14" Background="{StaticResource GuideBlueBrush}" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-7" Cursor="SizeNESW" DragDelta="ResizeHandle_DragDelta"/>
                        <Thumb x:Name="ResizeHandle_SE" Width="14" Height="14" Background="{StaticResource GuideBlueBrush}" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-7" Cursor="SizeNWSE" DragDelta="ResizeHandle_DragDelta"/>
                    </Grid>
                </Border>

                <!-- 원형 가이드라인 (원형 모드용) -->
                <Grid x:Name="CircleGuideline" Visibility="Collapsed">
                    <!-- 기본 뼈대 점선 원 (내경) -->
                    <Ellipse x:Name="CircleBaseShape" Stroke="{StaticResource GuideBlueBrush}" StrokeThickness="2" StrokeDashArray="3,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#3182F6" BlurRadius="10" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- 최대 돌출 상한선 원 (외경) -->
                    <Ellipse x:Name="CircleMaxShape" Stroke="{StaticResource GuideRedBrush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#E53935" BlurRadius="15" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- 원형 모드 라벨 (중앙 고정) -->
                    <Border Background="#C0000000" CornerRadius="6" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource GuideBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="CircleRadiusLabel" Foreground="{StaticResource GuideBlueBrush}" FontSize="13" FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock x:Name="CircleIntensityLabel" Foreground="{StaticResource GuideRedBrush}" FontSize="13" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Canvas>

            <!-- 사각형 가이드라인 라벨 (화면 상단 고정) -->
            <Border x:Name="RectGuidelineLabelBox" Background="#C0000000" CornerRadius="6" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" BorderBrush="{StaticResource GuideBorderBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="RectModeLabel" Foreground="{StaticResource GuideBlueBrush}" FontSize="13" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock x:Name="RectSizeLabel" Foreground="{StaticResource GuideRedBrush}" FontSize="13" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 좌측 설정 패널(폭 380). 오른쪽에서 왼쪽으로 쓰는 언어면 패널 내용만 뒤집는다(가이드라인과 그래픽은 그대로 둔다).
                 서식은 런처와 같은 Themes/Theme.xaml 이다. 좁은 패널이라 선택지 칸은 이름이 한 줄로 들어가는 만큼 줄을 나눈다. -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="380" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource ControlBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="24,40,24,32" FlowDirection="{Binding FlowDirection, Source={x:Static l:Loc.Instance}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 머리: 앱 이름, 제목, 언어 -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Sound Visualizer" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="EditPanelTitle" Style="{StaticResource Text.Section}" Margin="0,4,0,16" Text="{l:Loc editor.title}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EditPanelLanguageLabel" Style="{StaticResource Text.Caption}" Margin="0,0,12,0" Text="{l:Loc common.language}"/>
                            <ComboBox x:Name="CmbLanguage" Grid.Column="1" Style="{StaticResource ComboField}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=EditPanelLanguageLabel}"
                                      SelectionChanged="CmbLanguage_SelectionChanged" PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                        </Grid>
                        <Border Height="1" Margin="0,16,0,0" Background="{StaticResource ControlBrush}"/>
                    </StackPanel>

                    <!-- 스크롤 가능한 설정들 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,16,0,0">
                            <!-- 가이드라인을 마우스로 끌 수 있다는 안내 -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                                <TextBlock x:Name="DragTipText" Style="{StaticResource Text.Description}" Foreground="{StaticResource PrimaryTextBrush}" Text="{l:Loc editor.drag_tip}"/>
                            </Border>

                            <!-- 표현 모드·사운드 모드·최대 프레임 -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock x:Name="EditPanelVisualModeLabel" Style="{StaticResource Text.Label}" Margin="0,0,0,12" Text="{l:Loc settings.visual_mode.title}"/>
                                    <ui:ChoiceChipList x:Name="EditPanelVisualModeChips" Style="{StaticResource ChoiceChips}" Margin="0,0,0,24"
                                                       AutomationProperties.LabeledBy="{Binding ElementName=EditPanelVisualModeLabel}" SelectionChanged="EditPanelVisualMode_SelectionChanged">
                                        <ListBoxItem Content="{l:Loc settings.mode.wave}"/>
                                        <ListBoxItem Content="{l:Loc settings.mode.pad}"/>
                                        <ListBoxItem Content="{l:Loc settings.mode.circle}"/>
                                        <ListBoxItem Content="{l:Loc settings.mode.outline}"/>
                                    </ui:ChoiceChipList>

                                    <TextBlock x:Name="EditPanelSoundModeLabel" Style="{StaticResource Text.Label}" Margin="0,0,0,12" Text="{l:Loc settings.sound_mode.title}"/>
                                    <ui:ChoiceChipList x:Name="EditPanelSoundModeChips" Style="{StaticResource ChoiceChips}" Margin="0,0,0,24"
                                                       AutomationProperties.LabeledBy="{Binding ElementName=EditPanelSoundModeLabel}" SelectionChanged="EditPanelSoundMode_SelectionChanged">
                                        <ListBoxItem Content="{l:Loc settings.channels.2}"/>
                                        <ListBoxItem Content="{l:Loc settings.channels.5_1}"/>
                                        <ListBoxItem Content="{l:Loc settings.channels.7_1}"/>
                                    </ui:ChoiceChipList>

                                    <Slider x:Name="EditPanelTargetFpsSlider" Style="{StaticResource SliderRow}" Minimum="30" Maximum="240"
                                            ui:SettingRow.Label="{l:Loc settings.max_fps.title}" ui:SettingRow.ValueFormat="{}{0:F0} FPS" ValueChanged="EditPanelSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- 지금 모드의 크기·진하기·속도·민감도. 크기 고정을 켜면 고정 크기·최대 진하기를, 끄면 크기·진하기를 보인다. -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <CheckBox x:Name="EditPanelIntensityAsOpacityCheckBox" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.size_lock.title}"
                                              ui:SettingRow.Description="{l:Loc settings.size_lock.desc}" Checked="EditPanelIntensityAsOpacity_Changed" Unchecked="EditPanelIntensityAsOpacity_Changed"/>
                                    <StackPanel x:Name="EditPanelSizeLockedRows" Margin="16,0,0,0">
                                        <!-- 이름(파도 크기 등)은 모드에 따라 코드가 넣는다 -->
                                        <Slider x:Name="EditPanelOpacityFixedSizeSlider" Style="{StaticResource SliderRow}" Minimum="10" Maximum="100"
                                                ui:SettingRow.ValueFormat="{}{0:F0}%" ValueChanged="EditPanelSlider_ValueChanged"/>
                                        <Slider x:Name="EditPanelOpacityFixedMaxOpacitySlider" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100"
                                                ui:SettingRow.Label="{l:Loc settings.max_opacity.title}" ui:SettingRow.ValueFormat="{}{0:F0}%" ValueChanged="EditPanelSlider_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel x:Name="EditPanelSizeFreeRows">
                                        <Slider x:Name="EditPanelIntensitySlider" Style="{StaticResource SliderRow}" Minimum="10" Maximum="100"
                                                ui:SettingRow.Label="{l:Loc settings.size.title}" ui:SettingRow.ValueFormat="{}{0:F0}%" ValueChanged="EditPanelSlider_ValueChanged"/>
                                        <Slider x:Name="EditPanelOpacitySlider" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100"
                                                ui:SettingRow.Label="{l:Loc settings.opacity.title}" ui:SettingRow.ValueFormat="{}{0:F0}%" ValueChanged="EditPanelSlider_ValueChanged"/>
                                    </StackPanel>
                                    <Slider x:Name="EditPanelSpeedSlider" Style="{StaticResource SliderRow}" Minimum="1" Maximum="100"
                                            ui:SettingRow.Label="{l:Loc settings.speed.title}" ValueChanged="EditPanelSlider_ValueChanged"/>
                                    <Slider x:Name="EditPanelSensitivitySlider" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100"
                                            ui:SettingRow.Label="{l:Loc settings.sensitivity.title}" ValueChanged="EditPanelSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- 광원. 켜야 강도를 보인다. -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <CheckBox x:Name="EditPanelGlowCheckBox" Style="{StaticResource SwitchRow}" Content="{l:Loc editor.glow}" Checked="EditPanelGlow_Changed" Unchecked="EditPanelGlow_Changed"/>
                                    <Slider x:Name="EditPanelGlowSlider" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="0" Maximum="100" Visibility="Collapsed"
                                            ui:SettingRow.Label="{l:Loc editor.glow_strength}" ui:SettingRow.ValueFormat="{}{0:F0}%" ValueChanged="EditPanelSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- 소리 분류 표시와 색. 패널이 좁아 색 버튼마다 이름을 붙이지 않고 동그라미 열 위에 "색상"을 한 번 둔다.
                                 그만큼 스위치 이름이 넓어져 긴 번역이 단어 가운데서 끊기지 않는다. -->
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="EditPanelAIDisplayLabel" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" Text="{l:Loc settings.section.sound_types}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Margin="8,0,0,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Text="{l:Loc editor.color}"/>

                                    <CheckBox x:Name="EditPanelShowAmbientCheckBox" Grid.Row="1" Style="{StaticResource SwitchRow}" Margin="0,0,0,4" Content="{l:Loc settings.show_ambient}" Checked="EditPanelShowAmbient_Changed" Unchecked="EditPanelShowAmbient_Changed"/>
                                    <Button x:Name="EditPanelAmbientColorBtn" Grid.Row="1" Grid.Column="1" Style="{StaticResource Button.Swatch}" Margin="8,0,0,4" Tag="Ambient"
                                            AutomationProperties.Name="{l:Loc editor.color}" AutomationProperties.HelpText="{l:Loc settings.show_ambient}" Click="EditPanelColorBtn_Click"/>

                                    <CheckBox x:Name="EditPanelShowSpeechCheckBox" Grid.Row="2" Style="{StaticResource SwitchRow}" Margin="0,0,0,4" Content="{l:Loc settings.show_speech}" Checked="EditPanelShowSpeech_Changed" Unchecked="EditPanelShowSpeech_Changed"/>
                                    <Button x:Name="EditPanelSpeechColorBtn" Grid.Row="2" Grid.Column="1" Style="{StaticResource Button.Swatch}" Margin="8,0,0,4" Tag="Speech"
                                            AutomationProperties.Name="{l:Loc editor.color}" AutomationProperties.HelpText="{l:Loc settings.show_speech}" Click="EditPanelColorBtn_Click"/>

                                    <CheckBox x:Name="EditPanelShowDangerCheckBox" Grid.Row="3" Style="{StaticResource SwitchRow}" Margin="0" Content="{l:Loc settings.show_danger}" Checked="EditPanelShowDanger_Changed" Unchecked="EditPanelShowDanger_Changed"/>
                                    <Button x:Name="EditPanelDangerColorBtn" Grid.Row="3" Grid.Column="1" Style="{StaticResource Button.Swatch}" Margin="8,0,0,0" Tag="Danger"
                                            AutomationProperties.Name="{l:Loc editor.color}" AutomationProperties.HelpText="{l:Loc settings.show_danger}" Click="EditPanelColorBtn_Click"/>
                                </Grid>
                            </Border>

                            <!-- 단축키. 누르면 키를 기다린다(Esc 취소). -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="EditPanelHotkeySettingsLabel" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,16" Text="{l:Loc editor.hotkeys}"/>
                                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,8" Text="{l:Loc settings.hotkey.visual.title}"/>
                                    <Button x:Name="BtnEditPanelVisualHotkey" Style="{StaticResource Button.Secondary}" Margin="0,0,0,16" Content="F3"
                                            AutomationProperties.HelpText="{l:Loc settings.hotkey.visual.title}" Click="BtnEditPanelHotkey_Click"/>
                                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,8" Text="{l:Loc settings.hotkey.sound.title}"/>
                                    <Button x:Name="BtnEditPanelSoundModeHotkey" Style="{StaticResource Button.Secondary}" Margin="0,0,0,16" Content="F2"
                                            AutomationProperties.HelpText="{l:Loc settings.hotkey.sound.title}" Click="BtnEditPanelHotkey_Click"/>
                                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,8" Text="{l:Loc settings.hotkey.edit.title}"/>
                                    <Button x:Name="BtnEditPanelEditHotkey" Style="{StaticResource Button.Secondary}" Content="F4"
                                            AutomationProperties.HelpText="{l:Loc settings.hotkey.edit.title}" Click="BtnEditPanelHotkey_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 고급 -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock x:Name="EditPanelAdminSettingsLabel" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,16" Text="{l:Loc settings.section.advanced}"/>
                                    <CheckBox x:Name="EditPanelAdminCheckBox" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.developer_mode.title}"
                                              ui:SettingRow.Description="{l:Loc editor.developer_mode_desc}" Checked="EditPanelAdmin_Changed" Unchecked="EditPanelAdmin_Changed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 하단: 저장하고 닫는 키 안내와 오버레이 종료 -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource AccentFillBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="EditPanelHotkeyText" Text="F4" Foreground="{StaticResource OnFillBrush}" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="EditPanelSaveAndCloseDesc" Grid.Column="1" Style="{StaticResource Text.Description}" Margin="12,0,0,0" VerticalAlignment="Center" Text="{l:Loc editor.save_close_hint}"/>
                            </Grid>
                        </Border>
                        <Button x:Name="BtnCloseOverlay" Style="{StaticResource Button.Stop}" Content="{l:Loc editor.close_overlay}" Click="BtnCloseOverlay_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
