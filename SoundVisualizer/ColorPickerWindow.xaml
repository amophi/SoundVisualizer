<Window x:Class="SoundVisualizer.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SoundVisualizer.Localization"
        Title="{l:Loc color_picker.title}" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FontFamily="{DynamicResource AppFontFamily}">

    <!-- 안드로이드 색 선택 창과 같은 모양: 채도(가로) x 밝기(세로) 사각형, 색상 막대, #RRGGBB, 미리 담긴 색 8개(네 개씩 두 줄).
         색 코드는 키보드로 고칠 수 있게 입력칸으로 둔다. 서식과 색은 Themes/Theme.xaml 에 있다.
         오른쪽에서 왼쪽으로 쓰는 언어면 창 내용 전체를 뒤집는다. 사각형·막대의 마우스 좌표도 함께 뒤집혀 고른 색은 같다. -->
    <Border Background="{StaticResource CardBrush}" CornerRadius="20" BorderBrush="{StaticResource ControlBrush}" BorderThickness="1" FlowDirection="{Binding FlowDirection, Source={x:Static l:Loc.Instance}}">
        <StackPanel Margin="24">
            <!-- 제목과 닫기 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" Text="{l:Loc color_picker.title}"/>
                <Button Grid.Column="1" Style="{StaticResource Button.Chrome}" Width="36" Height="36" Tag="18" Margin="12,0,0,0" Content="&#xE8BB;"
                        AutomationProperties.Name="{l:Loc color_picker.cancel}" Click="BtnCancel_Click"/>
            </Grid>

            <!-- 채도 x 밝기. 누르거나 끌어서 고른다. 초점이 있으면 화살표 키로도 옮긴다(Shift 는 크게). -->
            <Border x:Name="SVBorder" Height="180" CornerRadius="12" Cursor="Cross" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
                    MouseLeftButtonDown="SV_MouseDown" MouseMove="SV_MouseMove" MouseLeftButtonUp="SV_MouseUp" KeyDown="SV_KeyDown" SizeChanged="Area_SizeChanged">
                <Grid>
                    <Border x:Name="SVHue" CornerRadius="12" Background="#FF0000"/>
                    <Border CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- 밝은 쪽에서도 안 묻히도록 흰 고리 바깥에 검은 고리를 겹친다 -->
                    <Canvas ClipToBounds="True" IsHitTestVisible="False">
                        <Grid x:Name="SVThumb" Width="22" Height="22">
                            <Ellipse Stroke="Black" StrokeThickness="1"/>
                            <Ellipse Margin="2" Stroke="White" StrokeThickness="2"/>
                        </Grid>
                    </Canvas>
                </Grid>
            </Border>

            <!-- 색상 -->
            <Border x:Name="HueBorder" Height="28" CornerRadius="14" Margin="0,16,0,0" Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
                    MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Hue_MouseUp" KeyDown="Hue_KeyDown" SizeChanged="Area_SizeChanged">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.1667"/>
                        <GradientStop Color="#00FF00" Offset="0.3333"/>
                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                        <GradientStop Color="#0000FF" Offset="0.6667"/>
                        <GradientStop Color="#FF00FF" Offset="0.8333"/>
                        <GradientStop Color="#FF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="HueThumb" Width="22" Height="22" Canvas.Top="3" Stroke="White" StrokeThickness="3"/>
                </Canvas>
            </Border>

            <!-- 고른 색과 #RRGGBB -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="44" Height="44" VerticalAlignment="Bottom">
                    <Border x:Name="ColorPreview" CornerRadius="12" Background="#FF0000"/>
                    <Border CornerRadius="12" BorderBrush="{StaticResource SecondaryTextBrush}" BorderThickness="1" Opacity="0.5"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="TxtHexLabel" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" Text="{l:Loc color_picker.hex}"/>
                    <!-- 16진 색 코드는 아랍어 화면에서도 왼쪽에서 오른쪽으로 쓴다("#" 이 뒤로 가지 않게) -->
                    <TextBox x:Name="TxtHexCode" Style="{StaticResource TextField}" FlowDirection="LeftToRight" MaxLength="9" Text="#FF0000"
                             AutomationProperties.LabeledBy="{Binding ElementName=TxtHexLabel}"
                             TextChanged="TxtHexCode_TextChanged" LostKeyboardFocus="TxtHexCode_LostKeyboardFocus"/>
                </StackPanel>
            </Grid>

            <!-- 미리 담긴 색 8개. 코드가 채운다. -->
            <UniformGrid x:Name="PresetGrid" Columns="4" Rows="2" Margin="0,16,0,0"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Button.Secondary}" IsCancel="True" Content="{l:Loc color_picker.cancel}" Click="BtnCancel_Click"/>
                <Button Grid.Column="2" Style="{StaticResource Button.Primary}" IsDefault="True" Content="{l:Loc color_picker.apply}" Click="BtnApply_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
