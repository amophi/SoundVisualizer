<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="SoundVisualizer.LauncherWindow"
        xmlns:l="clr-namespace:SoundVisualizer.Localization"
        xmlns:ui="clr-namespace:SoundVisualizer.Ui"
        Title="{l:Loc launcher.window_title}" Height="650" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp" FontFamily="{DynamicResource AppFontFamily}">

    <!-- 서식과 색은 Themes/Theme.xaml(App.xaml 에서 합침)에 있다. 아랍어처럼 오른쪽에서 왼쪽으로 쓰는 언어면 내용 전체를 뒤집는다. -->
    <Border CornerRadius="24" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource ControlBrush}" BorderThickness="1" FlowDirection="{Binding FlowDirection, Source={x:Static l:Loc.Instance}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 제목줄: 언어 콤보와 최소화·닫기 -->
            <Grid Grid.Row="0" Margin="24,24,24,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,100,0">
                    <TextBlock x:Name="TxtLanguageLabel" Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,0,10,0" Text="{l:Loc common.language}"/>
                    <!-- 항목(시스템 기본값 + 18개 언어)은 LanguagePicker 가 채운다 -->
                    <ComboBox x:Name="CmbLanguage" Style="{StaticResource ComboField}" Width="200"
                              AutomationProperties.LabeledBy="{Binding ElementName=TxtLanguageLabel}"
                              SelectionChanged="CmbLanguage_SelectionChanged" PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-24,0">
                    <Button Style="{StaticResource Button.Chrome}" Content="&#xE921;" Click="BtnMinimize_Click"/>
                    <Button Style="{StaticResource Button.ChromeClose}" Content="&#xE8BB;" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" Style="{StaticResource LauncherTabs}" Margin="24,20,24,0">

                <!-- 홈 (실행) 탭 -->
                <TabItem x:Name="TabHome" Header="{l:Loc launcher.tab.home}">
                    <StackPanel VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Style="{StaticResource Text.Title}" Margin="0,0,0,12" Text="Sound Visualizer"/>
                        <TextBlock Style="{StaticResource Text.Lead}" Margin="0,0,0,24" Text="{l:Loc launcher.home.desc}"/>

                        <StackPanel Margin="0,0,0,24">
                            <!-- 상태: 실행 중이면 점만 강조색이 된다(안드로이드 홈과 같다). 색과 글은 SetStatusUI 가 넣는다.
                                 실행·실행 종료를 누른 결과를 화면 읽어주기가 알려 준다(켜고 끌 때만 알린다). -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="TxtStatus" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </Grid>

                            <!-- 상태 줄 아래 안내(안드로이드 홈). 실행 중에는 AI 를 쓸 수 없을 때, 멈춘 뒤에는 사용자가 끄지 않았는데 꺼졌을 때 보인다.
                                 무엇을 보일지는 Core 의 RunStatus 가 정하고 UpdateNotices 가 넣는다. 글은 상태 점 너비(12 + 8)만큼 들여 상태 글과 줄을 맞춘다. -->
                            <TextBlock x:Name="TxtAiNotice" Style="{StaticResource Text.Warning}" Margin="20,8,0,0" Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="PanelStopped" Margin="20,8,0,0" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Text.Warning}" FontWeight="SemiBold" Text="{l:Loc notice.stopped.title}"/>
                                <!-- 제목과 내용을 한 번에 읽도록 이 글의 이름에 제목을 함께 넣는다(UpdateNotices). -->
                                <TextBlock x:Name="TxtStoppedText" Style="{StaticResource Text.Warning}" AutomationProperties.LiveSetting="Polite"/>
                                <!-- 다시 켜는 버튼은 따로 두지 않는다. 바로 아래 실행 버튼이 같은 일을 한다. -->
                                <Button x:Name="BtnDismissNotice" Style="{StaticResource Button.Text}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                        Content="{l:Loc notice.dismiss}" Click="BtnDismissNotice_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnLaunch" Style="{StaticResource Button.Primary.Large}" Content="{l:Loc launcher.home.start}" Click="BtnLaunch_Click"/>
                            <Button x:Name="BtnStop" Grid.Column="2" Style="{StaticResource Button.Stop.Large}" Content="{l:Loc launcher.home.stop}" Click="BtnStop_Click" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- 설정 탭. 순서는 안드로이드 설정 탭과 같다: 모드 → 모드별 상세 → 소리 분류 → (PC 만) 단축키 → 고급. -->
                <TabItem x:Name="TabSettings" Header="{l:Loc launcher.tab.settings}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False" Margin="0,16,0,0">
                        <StackPanel Margin="0,0,0,24">

                            <TextBlock Style="{StaticResource Text.Section}" Margin="0,0,0,16" Text="{l:Loc settings.section.mode}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtVisualModeLabel" Style="{StaticResource Text.Label}" Text="{l:Loc settings.visual_mode.title}"/>
                                    <TextBlock Style="{StaticResource Text.Description}" Margin="0,4,0,12" Text="{l:Loc settings.visual_mode.desc}"/>
                                    <ui:ChoiceChipList x:Name="ChipsVisualMode" Style="{StaticResource ChoiceChips}" Margin="0,0,0,24"
                                                       AutomationProperties.LabeledBy="{Binding ElementName=TxtVisualModeLabel}" SelectionChanged="ChoiceChips_SelectionChanged">
                                        <ListBoxItem Content="{l:Loc settings.mode.wave}"/>
                                        <ListBoxItem Content="{l:Loc settings.mode.pad}"/>
                                        <ListBoxItem Content="{l:Loc settings.mode.circle}"/>
                                        <ListBoxItem Content="{l:Loc settings.mode.outline}"/>
                                    </ui:ChoiceChipList>

                                    <TextBlock x:Name="TxtSoundModeLabel" Style="{StaticResource Text.Label}" Text="{l:Loc settings.sound_mode.title}"/>
                                    <TextBlock Style="{StaticResource Text.Description}" Margin="0,4,0,12" Text="{l:Loc settings.sound_mode.desc}"/>
                                    <ui:ChoiceChipList x:Name="ChipsSoundMode" Style="{StaticResource ChoiceChips}" Margin="0,0,0,24"
                                                       AutomationProperties.LabeledBy="{Binding ElementName=TxtSoundModeLabel}" SelectionChanged="ChoiceChips_SelectionChanged">
                                        <ListBoxItem Content="{l:Loc settings.channels.2}"/>
                                        <ListBoxItem Content="{l:Loc settings.channels.5_1}"/>
                                        <ListBoxItem Content="{l:Loc settings.channels.7_1}"/>
                                    </ui:ChoiceChipList>

                                    <Slider x:Name="SldTargetFps" Style="{StaticResource SliderRow}" Minimum="30" Maximum="240"
                                            ui:SettingRow.Label="{l:Loc settings.max_fps.title}" ui:SettingRow.Description="{l:Loc settings.max_fps.desc}"
                                            ui:SettingRow.ValueFormat="{}{0:F0} FPS" ValueChanged="Setting_Changed"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Text.Section}" Text="{l:Loc settings.section.mode_detail}"/>

                            <!-- 모드 카드들. 고른 모드의 카드가 펼쳐져 맨 위로 온다(UpdateExpanderStates).
                                 카드 안 순서는 안드로이드와 같다: 크기 고정 → (고정 크기, 최대 진하기) / (크기, [반지름], 진하기) → 속도 → 민감도 → 광원.
                                 크기 고정을 켜면 크기·진하기 대신 고정 크기·최대 진하기를 쓴다. 지금 먹지 않는 쪽은 흐리게 남기지 않고 접는다. -->
                            <StackPanel x:Name="PanelModeExpanders">
                                <Expander x:Name="ExpanderWave" Style="{StaticResource ExpanderCard}" Header="{l:Loc settings.mode_card.wave}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkIntensityAsOpacityWave" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.size_lock.title}" ui:SettingRow.Description="{l:Loc settings.size_lock.desc}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityFixedSizeWave" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="10" Maximum="100" ui:SettingRow.Label="{l:Loc settings.fixed_size.wave}" ui:SettingRow.Description="{l:Loc settings.fixed_size.desc}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityFixedMaxOpacityWave" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.max_opacity.title}" ui:SettingRow.Description="{l:Loc settings.max_opacity.desc}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldIntensityWave" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.size.title}" ui:SettingRow.Description="{l:Loc settings.size.desc.wave}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityWave" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.opacity.title}" ui:SettingRow.Description="{l:Loc settings.opacity.desc.wave}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldSpeedWave" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.speed.title}" ui:SettingRow.Description="{l:Loc settings.speed.desc.wave}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldSensitivityWave" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.sensitivity.title}" ui:SettingRow.Description="{l:Loc settings.sensitivity.desc.wave}" ValueChanged="Setting_Changed"/>
                                        <CheckBox x:Name="ChkGlowModeWave" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.glow.title}" ui:SettingRow.Description="{l:Loc settings.glow.desc.wave}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Slider x:Name="SldGlowIntensityWave" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc editor.glow_strength}" ValueChanged="Setting_Changed"/>
                                        <Button x:Name="BtnResetWave" Style="{StaticResource Button.Secondary}" Margin="0,0,0,24" Content="{l:Loc common.reset_defaults}" Click="BtnResetWave_Click"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="ExpanderPad" Style="{StaticResource ExpanderCard}" Header="{l:Loc settings.mode_card.pad}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkIntensityAsOpacityPad" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.size_lock.title}" ui:SettingRow.Description="{l:Loc settings.size_lock.desc}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityFixedSizePad" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="10" Maximum="100" ui:SettingRow.Label="{l:Loc settings.fixed_size.pad}" ui:SettingRow.Description="{l:Loc settings.fixed_size.desc}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityFixedMaxOpacityPad" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.max_opacity.title}" ui:SettingRow.Description="{l:Loc settings.max_opacity.desc}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldIntensityPad" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.size.title}" ui:SettingRow.Description="{l:Loc settings.size.desc.pad}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityPad" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.opacity.title}" ui:SettingRow.Description="{l:Loc settings.opacity.desc.pad}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldSpeedPad" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.speed.title}" ui:SettingRow.Description="{l:Loc settings.speed.desc.pad}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldSensitivityPad" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.sensitivity.title}" ui:SettingRow.Description="{l:Loc settings.sensitivity.desc.pad}" ValueChanged="Setting_Changed"/>
                                        <CheckBox x:Name="ChkGlowModePad" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.glow.title}" ui:SettingRow.Description="{l:Loc settings.glow.desc.pad}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Slider x:Name="SldGlowIntensityPad" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc editor.glow_strength}" ValueChanged="Setting_Changed"/>
                                        <Button x:Name="BtnResetPad" Style="{StaticResource Button.Secondary}" Margin="0,0,0,24" Content="{l:Loc common.reset_defaults}" Click="BtnResetPad_Click"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="ExpanderCircle" Style="{StaticResource ExpanderCard}" Header="{l:Loc settings.mode_card.circle}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkIntensityAsOpacityCircle" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.size_lock.title}" ui:SettingRow.Description="{l:Loc settings.size_lock.desc}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityFixedSizeCircle" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="10" Maximum="100" ui:SettingRow.Label="{l:Loc settings.fixed_size.circle}" ui:SettingRow.Description="{l:Loc settings.fixed_size.desc}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityFixedMaxOpacityCircle" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.max_opacity.title}" ui:SettingRow.Description="{l:Loc settings.max_opacity.desc}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldIntensityCircle" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.size.title}" ui:SettingRow.Description="{l:Loc settings.size.desc.circle}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldCircleRadius" Style="{StaticResource SliderRow}" Minimum="10" Maximum="100" ui:SettingRow.Label="{l:Loc settings.radius.title}" ui:SettingRow.Description="{l:Loc settings.radius.desc}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityCircle" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.opacity.title}" ui:SettingRow.Description="{l:Loc settings.opacity.desc.circle}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldSpeedCircle" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.speed.title}" ui:SettingRow.Description="{l:Loc settings.speed.desc.circle}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldSensitivityCircle" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.sensitivity.title}" ui:SettingRow.Description="{l:Loc settings.sensitivity.desc.circle}" ValueChanged="Setting_Changed"/>
                                        <CheckBox x:Name="ChkGlowModeCircle" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.glow.title}" ui:SettingRow.Description="{l:Loc settings.glow.desc.circle}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Slider x:Name="SldGlowIntensityCircle" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc editor.glow_strength}" ValueChanged="Setting_Changed"/>
                                        <Button x:Name="BtnResetCircle" Style="{StaticResource Button.Secondary}" Margin="0,0,0,24" Content="{l:Loc common.reset_defaults}" Click="BtnResetCircle_Click"/>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="ExpanderOutline" Style="{StaticResource ExpanderCard}" Header="{l:Loc settings.mode_card.outline}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkIntensityAsOpacityOutline" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.size_lock.title}" ui:SettingRow.Description="{l:Loc settings.size_lock.desc}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityFixedSizeOutline" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="10" Maximum="100" ui:SettingRow.Label="{l:Loc settings.fixed_size.outline}" ui:SettingRow.Description="{l:Loc settings.fixed_size.desc}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityFixedMaxOpacityOutline" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.max_opacity.title}" ui:SettingRow.Description="{l:Loc settings.max_opacity.desc}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldIntensityOutline" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.size.title}" ui:SettingRow.Description="{l:Loc settings.size.desc.outline}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldOpacityOutline" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.opacity.title}" ui:SettingRow.Description="{l:Loc settings.opacity.desc.outline}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldSpeedOutline" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.speed.title}" ui:SettingRow.Description="{l:Loc settings.speed.desc.outline}" ValueChanged="Setting_Changed"/>
                                        <Slider x:Name="SldSensitivityOutline" Style="{StaticResource SliderRow}" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc settings.sensitivity.title}" ui:SettingRow.Description="{l:Loc settings.sensitivity.desc.outline}" ValueChanged="Setting_Changed"/>
                                        <CheckBox x:Name="ChkGlowModeOutline" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.glow.title}" ui:SettingRow.Description="{l:Loc settings.glow.desc.outline}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Slider x:Name="SldGlowIntensityOutline" Style="{StaticResource SliderRow}" Margin="16,0,0,24" Minimum="0" Maximum="100" ui:SettingRow.Label="{l:Loc editor.glow_strength}" ValueChanged="Setting_Changed"/>
                                        <Button x:Name="BtnResetOutline" Style="{StaticResource Button.Secondary}" Margin="0,0,0,24" Content="{l:Loc common.reset_defaults}" Click="BtnResetOutline_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- 소리 종류마다 표시 스위치 줄과 색 버튼. 색 버튼은 스위치 줄 밖에 둔다(안에 두면 함께 눌린다). -->
                            <TextBlock Style="{StaticResource Text.Section}" Text="{l:Loc settings.section.sound_types}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkShowAmbient" Style="{StaticResource SwitchRow}" Margin="0" Content="{l:Loc settings.show_ambient}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Button x:Name="BtnColorAmbient" Grid.Column="1" Style="{StaticResource Button.Swatch}" Margin="24,0,0,0" Tag="Ambient"
                                                Content="{l:Loc settings.set_color}" AutomationProperties.HelpText="{l:Loc settings.show_ambient}" Click="BtnColor_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkShowSpeech" Style="{StaticResource SwitchRow}" Margin="0" Content="{l:Loc settings.show_speech}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Button x:Name="BtnColorSpeech" Grid.Column="1" Style="{StaticResource Button.Swatch}" Margin="24,0,0,0" Tag="Speech"
                                                Content="{l:Loc settings.set_color}" AutomationProperties.HelpText="{l:Loc settings.show_speech}" Click="BtnColor_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkShowDanger" Style="{StaticResource SwitchRow}" Margin="0" Content="{l:Loc settings.show_danger}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Button x:Name="BtnColorDanger" Grid.Column="1" Style="{StaticResource Button.Swatch}" Margin="24,0,0,0" Tag="Danger"
                                                Content="{l:Loc settings.set_color}" AutomationProperties.HelpText="{l:Loc settings.show_danger}" Click="BtnColor_Click"/>
                                    </Grid>
                                    <Button x:Name="BtnResetSoundClassification" Style="{StaticResource Button.Secondary}" Content="{l:Loc common.reset_defaults}" Click="BtnResetSoundClassification_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Text.Section}" Text="{l:Loc settings.section.hotkeys}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc settings.hotkey.visual.title}"/>
                                            <TextBlock Style="{StaticResource Text.Description}" Margin="0,4,0,0" Text="{l:Loc settings.hotkey.visual.desc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,12,0" Text="{l:Loc settings.hotkey.set}"/>
                                            <Button x:Name="BtnVisualHotkey" Style="{StaticResource Button.Secondary}" MinWidth="120" Content="F3"
                                                    AutomationProperties.HelpText="{l:Loc settings.hotkey.visual.title}" Click="BtnVisualHotkey_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc settings.hotkey.sound.title}"/>
                                            <TextBlock Style="{StaticResource Text.Description}" Margin="0,4,0,0" Text="{l:Loc settings.hotkey.sound.desc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,12,0" Text="{l:Loc settings.hotkey.set}"/>
                                            <Button x:Name="BtnSoundModeHotkey" Style="{StaticResource Button.Secondary}" MinWidth="120" Content="F2"
                                                    AutomationProperties.HelpText="{l:Loc settings.hotkey.sound.title}" Click="BtnSoundModeHotkey_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc settings.hotkey.edit.title}"/>
                                            <TextBlock Style="{StaticResource Text.Description}" Margin="0,4,0,0" Text="{l:Loc settings.hotkey.edit.desc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,12,0" Text="{l:Loc settings.hotkey.set}"/>
                                            <Button x:Name="BtnEditHotkey" Style="{StaticResource Button.Secondary}" MinWidth="120" Content="F4"
                                                    AutomationProperties.HelpText="{l:Loc settings.hotkey.edit.title}" Click="BtnEditHotkey_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Text.Section}" Text="{l:Loc settings.section.advanced}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAdminMode" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.developer_mode.title}" ui:SettingRow.Description="{l:Loc settings.developer_mode.desc}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <!-- 개발자 모드에 딸린 스위치. 개발자 모드를 끄면 접는다(값은 남는다. 안드로이드 DependentSettings). -->
                                    <CheckBox x:Name="ChkDeveloperRecord" Style="{StaticResource SwitchRow}" Margin="16,0,0,24" Content="{l:Loc settings.developer_record.title}" ui:SettingRow.Description="{l:Loc settings.developer_record.desc}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <CheckBox x:Name="ChkAutoMinimizeOnLaunch" Style="{StaticResource SwitchRow}" Content="{l:Loc settings.auto_minimize.title}" ui:SettingRow.Description="{l:Loc settings.auto_minimize.desc}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnReset" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0" Content="{l:Loc common.reset_defaults}" Click="BtnReset_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 소리 탭(안드로이드 분류 탭). 소리마다 어느 종류로 볼지 고른다. 내용은 Ui/SoundsTab 이 그린다. -->
                <TabItem x:Name="TabSounds" Header="{l:Loc launcher.tab.sounds}">
                    <ui:SoundsTab x:Name="SoundsTabView"/>
                </TabItem>

                <!-- 도움말 탭 -->
                <TabItem x:Name="TabHelp" Header="{l:Loc launcher.tab.help}">
                    <!-- 내용은 HelpTab.xaml(안드로이드 도움말 탭의 펼치기 카드 구성) -->
                    <local:HelpTab xmlns:local="clr-namespace:SoundVisualizer"/>
                </TabItem>

                <!-- 더 알아보기 탭 -->
                <TabItem x:Name="TabMoreInfo" Header="{l:Loc launcher.tab.more_info}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False" Margin="0,16,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" Text="{l:Loc more_info.title}"/>
                                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,24" Text="{l:Loc more_info.body}"/>
                                    <Button x:Name="BtnMoreInfoGithub" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Content="{l:Loc more_info.github_button}" Click="BtnMoreInfoGithub_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
