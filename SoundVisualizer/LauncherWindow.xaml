                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtHelp3Title" Text="{l:Loc help.editor.title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextColor}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtHelp3Desc" Text="{l:Loc help.editor.body}" 
                                               FontSize="15" Foreground="{StaticResource SecondaryTextColor}" LineHeight="24" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtHelp4Title" Text="{l:Loc help.ai.title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextColor}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtHelp4Desc" Text="{l:Loc help.ai.body}" 
                                               FontSize="15" Foreground="{StaticResource SecondaryTextColor}" LineHeight="24" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtHelp5Title" Text="{l:Loc help.developer.title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextColor}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtHelp5Desc" Text="{l:Loc help.developer.body}" 
                                               FontSize="15" Foreground="{StaticResource SecondaryTextColor}" LineHeight="24" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 더 알아보기 탭 -->
                <TabItem x:Name="TabMoreInfo" Header="{l:Loc launcher.tab.more_info}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,16,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel Margin="0,8">
                                    <TextBlock x:Name="TxtMoreInfoTitle" Text="{l:Loc more_info.title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextColor}" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="TxtMoreInfoDesc" Text="{l:Loc more_info.body}" 
                                               FontSize="15" Foreground="{StaticResource SecondaryTextColor}" LineHeight="24" TextWrapping="Wrap" Margin="0,0,0,24"/>
                                    <Button x:Name="BtnMoreInfoGithub" Content="{l:Loc more_info.github_button}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Padding="28,14" Click="BtnMoreInfoGithub_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>


