<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:SoundVisualizer.Ui">
    <!-- 런처·오버레이 편집 패널·색 선택 창이 함께 쓰는 서식. 안드로이드 판의 UiControls.kt·SettingsTab.kt 모양을 옮겼다.
         글자 크기는 13(설명) / 16(이름) / 18(카드 제목) / 22(구역 제목) / 36(홈 제목), 글꼴은 창의 AppFontFamily(Pretendard) 다.
         번역이 길어도 잘리지 않게 글자는 모두 줄을 바꾸고, 높이는 내용에 맞춰 늘어난다. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SoundVisualizer;component/Themes/Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ui:ValueFormatConverter x:Key="ValueFormatConverter"/>
    <ui:HotkeyNameConverter x:Key="HotkeyNameConverter"/>

    <!-- ===== 키보드 초점 ===== -->
    <!-- 2px 강조색 테두리. 카드 위 5.9:1, 바탕 위 5.0:1 이라 그림 요소 기준(3:1)을 넘는다.
         FocusVisualStyle 이라 Tab 키로 옮길 때만 그려지고 마우스로 누를 때는 그려지지 않는다. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" RadiusX="12" RadiusY="12" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 둥근 모서리 14 인 버튼 바깥 -->
    <Style x:Key="FocusRingButton">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" RadiusX="18" RadiusY="18" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 카드 머리처럼 가장자리에 붙은 것은 안쪽에 그린다(바깥에 그리면 카드 둥근 모서리와 어긋난다) -->
    <Style x:Key="FocusRingInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" RadiusX="18" RadiusY="18" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 창 제목줄 버튼처럼 창 가장자리에 붙은 작은 것. 바깥에 그리면 창 밖으로 잘린다. -->
    <Style x:Key="FocusRingChrome">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" RadiusX="6" RadiusY="6" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 동그라미(색 버튼, 미리 담긴 색) -->
    <Style x:Key="FocusRingRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Margin="-2" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 글자 ===== -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="LineHeight" Value="48"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 설정의 구역 제목 -->
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,16"/>
    </Style>

    <Style x:Key="Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 설정 이름 -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 홈의 소개 글 -->
    <Style x:Key="Text.Lead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 도움말·더 알아보기 본문 -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 설정 이름 아래 설명. 바탕 위 대비가 4.6:1 이라 13 보다 작게 하지 않는다. -->
    <Style x:Key="Text.Description" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 버튼 옆의 작은 이름("단축키 설정", "언어") -->
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 안내·주의 -->
    <Style x:Key="Text.Warning" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Link" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 카드 ===== -->
    <!-- 모서리 20, 안쪽 24, 카드 사이 16 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- 설정 줄을 담는 카드. 줄마다 아래 여백 24 를 가지므로 카드 아래 안쪽 여백은 줄이 채운다. -->
    <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="24,24,24,0"/>
    </Style>

    <!-- 제목을 누르면 펼쳐지는 카드(설정의 모드 카드). 누르는 자리는 제목 줄만이 아니라 카드 위쪽 여백까지 머리 전체다. -->
    <Style x:Key="ExpanderCard" TargetType="Expander">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderButton" DockPanel.Dock="Top" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand" FocusVisualStyle="{StaticResource FocusRingInset}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="24,20" MinHeight="64">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"
                                                                  TextElement.FontSize="18" TextElement.FontWeight="Bold"
                                                                  TextElement.Foreground="{StaticResource PrimaryTextBrush}">
                                                    <ContentPresenter.Resources>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                        </Style>
                                                    </ContentPresenter.Resources>
                                                </ContentPresenter>
                                                <Path x:Name="Chevron" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                                      Data="M 0,0 L 6,6 L 12,0" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource PrimaryTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="24,4,24,0" Visibility="Collapsed"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 버튼 ===== -->
    <!-- 공통 뼈대. 모서리 14, 높이 48 이상, 글자는 가운데 정렬로 줄을 바꾼다. 색은 아래 변형이 정한다. -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource OnFillBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 강조 버튼: 흰 글자 5.2:1 -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentFillHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentFillPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 보조 버튼: 조작 요소 바탕에 본 글자 10.4:1 -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 단축키 버튼(설정 탭, 편집 패널). 글자는 지금 키("F3")뿐이라 화면 읽어주기에는 무엇의 단축키인지(ui:SettingRow.Label)와
         지금 키를 함께 읽힌다("표현 모드 전환, 단축키: F3", HotkeyNameConverter). 키를 받는 중에는 안내 글이 키 자리에 들어가고,
         버튼 글자가 바뀌면 이름도 따라 바뀐다. 설명(ui:SettingRow.Description)은 도움말로 읽힌다. -->
    <Style x:Key="Button.Hotkey" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="AutomationProperties.Name">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource HotkeyNameConverter}">
                    <Binding Path="(ui:SettingRow.Label)" RelativeSource="{RelativeSource Self}"/>
                    <Binding Path="Content" RelativeSource="{RelativeSource Self}"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="AutomationProperties.HelpText" Value="{Binding (ui:SettingRow.Description), RelativeSource={RelativeSource Self}}"/>
    </Style>

    <!-- 멈춤 버튼(실행 종료, 오버레이 종료): 흰 글자 5.0:1 -->
    <Style x:Key="Button.Stop" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource StopBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource StopHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource StopPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 홈의 실행·실행 종료. 높이 56, 번역이 길면 두 줄까지 들어가게 좌우 여백을 줄였다(안드로이드 홈과 같다). -->
    <Style x:Key="Button.Primary.Large" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="Button.Stop.Large" TargetType="Button" BasedOn="{StaticResource Button.Stop}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- 글자만 있는 버튼(홈 안내의 "안내 닫기"). 안드로이드 TextButton 처럼 바탕 없이 보조 글자색 굵게 두고, 마우스를 올리면 바탕이 생긴다.
         보조 글자는 카드·바탕 위 4.6:1 이상이다. -->
    <Style x:Key="Button.Text" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingButton}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlPressedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 소리 종류 색 버튼: 이름("색상 설정") + 32px 동그라미. 동그라미 색은 코드가 Background 로 넣는다. 누르는 자리는 이름까지 48px 높이다.
         이름(Content)을 비우면 동그라미만 둔다. 그때는 AutomationProperties.Name 으로 이름을 준다. -->
    <Style x:Key="Button.Swatch" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Caption" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Ellipse x:Name="Ring" Grid.Column="1" Width="42" Height="42" Stroke="Transparent" StrokeThickness="2"/>
                        <Ellipse Grid.Column="1" Width="32" Height="32" Fill="{TemplateBinding Background}"/>
                        <Ellipse Grid.Column="1" Width="32" Height="32" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1" Opacity="0.5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 이름 없이 동그라미만 둘 때(편집 패널은 열 머리에 이름이 있다) -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Caption" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 색 선택 창의 미리 담긴 색. 동그라미는 30px, 누르는 칸은 48px 이다(안드로이드와 같다). 지금 색과 같은 칸은 흰 고리로 보인다.
         라디오 버튼이라 화면 읽어주기가 고른 칸을 "선택됨"으로 읽는다. -->
    <Style x:Key="PresetChoice" TargetType="RadioButton">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Width="40" Height="40" Stroke="Transparent" StrokeThickness="2"/>
                        <Ellipse Width="30" Height="30" Fill="{TemplateBinding Background}"/>
                        <Ellipse Width="30" Height="30" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1" Opacity="0.4"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 창 제목줄의 최소화·닫기(아이콘 글꼴). 닫기는 창 오른쪽 위 모서리에 맞춰 둥글린다.
         아이콘 글자는 화면 읽어주기가 읽을 수 없으므로 버튼마다 AutomationProperties.Name(최소화, 닫기)을 준다.
         아이콘은 ContentPresenter 대신 서식 안의 TextBlock 으로 그린다. 서식 안의 글자는 자동화 요소가 되지 않아, 이름 밑에 아이콘 글자가
         따로 읽히지 않는다. 툴팁은 두지 않는다. 툴팁은 도움말로도 읽혀 이름을 두 번 듣게 된다. -->
    <Style x:Key="Button.Chrome" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- 모서리 둥글기. 닫기 버튼만 창 모서리에 맞춘다(Tag 글자를 CornerRadius 로 바꿔 읽는다) -->
        <Setter Property="Tag" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingChrome}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.ChromeClose" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
        <Setter Property="Tag" Value="0,24,0,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource StopBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource OnFillBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 스위치 줄 ===== -->
    <!-- 이름(16 굵게)·설명(13)·스위치를 한 덩어리로 두고 줄 전체를 누르면 켜고 끈다(안드로이드 ModernSwitch).
         이름은 Content, 설명은 ui:SettingRow.Description. 화면 읽어주기는 이름과 켜짐·꺼짐을 함께 읽는다. -->
    <Style x:Key="SwitchRow" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="AutomationProperties.HelpText" Value="{Binding (ui:SettingRow.Description), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- 바탕을 투명하게라도 칠해야 글자 사이 빈 곳을 눌러도 켜고 끈다 -->
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Grid Grid.Column="1" Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="12" Background="{StaticResource ControlBrush}"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="4,0" HorizontalAlignment="Left" Fill="{StaticResource SecondaryTextBrush}"/>
                        </Grid>
                        <TextBlock x:Name="Description" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{StaticResource Text.Description}"
                                   Text="{Binding (ui:SettingRow.Description), RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:SettingRow.Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource OnFillBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Width" Value="18"/>
                            <Setter TargetName="Thumb" Property="Height" Value="18"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="3,0"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentFillHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource DisabledTrackBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource DisabledThumbBrush}"/>
                            <Setter TargetName="Description" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource DisabledActiveTrackBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource DisabledCheckedThumbBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 슬라이더 줄 ===== -->
    <!-- 이름과 값을 위 한 줄(16 굵게)에, 막대를 그 아래 한 줄에, 설명(13)을 맨 아래에 둔다(안드로이드 ModernSlider).
         이름·값을 막대와 한 줄에 두면 막대가 짧아지고 긴 번역은 좁은 이름 칸에서 여러 줄로 접힌다.
         이름·설명 글자는 누름을 받지 않는다. 받으면 IsMoveToPointEnabled 때문에 글자를 누른 가로 위치로 값이 뛴다. -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bar" Height="6" CornerRadius="3,0,0,3" Background="{StaticResource AccentFillBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource DisabledActiveTrackBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="28" Height="28" Background="Transparent">
                        <Ellipse x:Name="Halo" Fill="{StaticResource AccentFillBrush}" Opacity="0"/>
                        <Ellipse x:Name="Knob" Width="20" Height="20" Fill="{StaticResource OnFillBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.35"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource DisabledThumbBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRow" TargetType="Slider">
        <Setter Property="Margin" Value="0,0,0,24"/>
        <Setter Property="SmallChange" Value="1"/>
        <Setter Property="LargeChange" Value="10"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding (ui:SettingRow.Label), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="AutomationProperties.HelpText" Value="{Binding (ui:SettingRow.Description), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="Head" IsHitTestVisible="False">
                            <TextBlock x:Name="ValueText" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top"
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ValueFormatConverter}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="(ui:SettingRow.ValueFormat)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock x:Name="Label" Style="{StaticResource Text.Label}"
                                       Text="{Binding (ui:SettingRow.Label), RelativeSource={RelativeSource TemplatedParent}}"/>
                        </DockPanel>
                        <!-- 막대 줄은 32px 높이 전체가 누르는 자리다 -->
                        <Grid Grid.Row="1" Height="32" Margin="0,4,0,0" Background="Transparent">
                            <Border x:Name="Rest" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{StaticResource ControlBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderRest}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <TextBlock x:Name="Description" Grid.Row="2" Margin="0,2,0,0" IsHitTestVisible="False" Style="{StaticResource Text.Description}"
                                   Text="{Binding (ui:SettingRow.Description), RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:SettingRow.Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ui:SettingRow.Label" Value="{x:Null}">
                            <Setter TargetName="Head" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- 쓸 수 없는 값은 글자까지 흐리게 해야 "지금은 안 먹는 값"으로 읽힌다 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Head" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Description" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Rest" Property="Background" Value="{StaticResource DisabledTrackBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 선택지 칸 ===== -->
    <!-- 표현 모드·사운드 모드. 고른 칸은 강조 바탕에 흰 글자(5.2:1), 나머지는 조작 요소 바탕에 본 글자(10.4:1).
         칸은 48px 이상이고, 칸 수와 줄 나눔은 EqualChoicePanel 이 정한다. -->
    <Style x:Key="ChoiceChip" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="8,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chip" Background="{StaticResource ControlBrush}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnFillBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChoiceChips" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceChip}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <ui:EqualChoicePanel Gap="8"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <!-- 스크롤 영역을 두지 않는다. 두면 칸 위에서 굴린 마우스 휠을 이 목록이 먹어 설정 화면이 내려가지 않는다. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 콤보 상자(언어) ===== -->
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Margin="0,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnFillBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboField" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8,36,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Data="M 0,0 L 5,5 L 10,0"
                                              Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Margin="0,6,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource ControlBrush}" BorderThickness="1" CornerRadius="10"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Margin="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 글자 입력칸(색 코드) ===== -->
    <Style x:Key="TextField" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentFillBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <!-- 초점은 테두리 색으로 보인다 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 탭(홈·설정·도움말·더 알아보기) ===== -->
    <!-- 모양은 예전 그대로다. 이름이 길어 한 줄에 다 들어가지 않으면 다음 줄로 넘어간다. -->
    <Style x:Key="LauncherTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 탭 사이 간격은 탭 밖(Margin)에 둔다. 안에 두면 초점 테두리가 간격까지 감싸 옆 탭 글자에 닿는다(오른쪽에서 왼쪽 화면). -->
        <Setter Property="Margin" Value="0,0,24,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12" RecognizesAccessKey="False"/>
                        <Border x:Name="Indicator" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource PrimaryTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LauncherTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource LauncherTab}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- TabPanel 은 탭의 Margin 을 무시하고 탭 안으로 밀어 넣어 글자가 잘린다. WrapPanel 은 간격을 지키고,
                             이름이 길면 순서대로 다음 줄로 넘긴다(TabPanel 은 고른 탭의 줄을 맨 아래로 옮긴다).
                             키보드는 TabPanel 처럼 둔다: 탭 줄에서는 Tab 이 한 번만 멈추고(지금 탭), 탭끼리는 화살표로 옮긴다.
                             탭마다 멈추면 탭에 초점이 갈 때마다 그 탭이 골라져, Tab 만으로는 마지막 탭(더 알아보기)의 내용에만 닿는다. -->
                        <WrapPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"
                                   KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
