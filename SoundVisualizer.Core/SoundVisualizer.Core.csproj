<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.3" />
  </ItemGroup>

  <!-- 분류 탭(Sounds)의 데이터: 18개 언어의 소리 이름과 새로 지은 묶음 이름, 묶음 표. 고지는 Sounds/Data/NOTICE.txt.
       코드(SoundData)가 이 이름으로 읽으므로 폴더 이름과 상관없게 리소스 이름을 정해 둔다.
       "ko.json" 같은 이름을 문화권 위성 어셈블리로 떼어 내지 않게 WithCulture 를 끈다. -->
  <ItemGroup>
    <EmbeddedResource Include="Sounds\Data\SoundNames\*.json" LogicalName="SoundVisualizer.Sounds.Data.SoundNames.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Sounds\Data\GroupTitles\*.json" LogicalName="SoundVisualizer.Sounds.Data.GroupTitles.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Sounds\Data\sound_groups.tsv" LogicalName="SoundVisualizer.Sounds.Data.sound_groups.tsv" WithCulture="false" />
  </ItemGroup>

  <!-- 화면 문자열 표. StringTables 가 이 이름으로 찾는다. "ko.json" 같은 이름을 문화권 위성 어셈블리로 떼어 내지 않게 WithCulture 를 끈다. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings\*.json" LogicalName="SoundVisualizer.Localization.Strings.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <!-- 도움말의 오픈소스 라이선스 창이 보이는 고지(Help/LicenseNotices). 저장소의 원본을 제자리에서 넣는다.
       복사본을 두면 원본만 고치고 잊었을 때 배포되는 앱에 옛 고지가 남는다. 이름은 LicenseNotices.Documents 와 맞춘다. -->
  <ItemGroup>
    <EmbeddedResource Include="..\THIRD_PARTY.md" Link="Licenses\THIRD_PARTY.md" LogicalName="SoundVisualizer.Licenses.THIRD_PARTY.md" WithCulture="false" />
    <EmbeddedResource Include="..\SoundVisualizer\Fonts\Pretendard-LICENSE.txt" Link="Licenses\Pretendard-LICENSE.txt" LogicalName="SoundVisualizer.Licenses.Pretendard-LICENSE.txt" WithCulture="false" />
    <EmbeddedResource Include="Sounds\Data\NOTICE.txt" LogicalName="SoundVisualizer.Licenses.NOTICE.txt" WithCulture="false" />
    <EmbeddedResource Include="..\LICENSE" Link="Licenses\LICENSE" LogicalName="SoundVisualizer.Licenses.LICENSE" WithCulture="false" />
  </ItemGroup>

</Project>
